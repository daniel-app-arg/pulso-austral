# Copiar a .env y completar. Nunca commitear el .env real.

SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite si se omite. Para Neon (ver README → "Base de datos en Neon"),
# pegar acá el connection string que da Neon tal cual (ya trae sslmode=require):
# DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/pulso_austral?sslmode=require
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
